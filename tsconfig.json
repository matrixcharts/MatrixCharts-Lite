{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "node16",
        "moduleResolution": "node16",
        "declaration": true,
        "declarationMap": true,
        "rootDir": "./src",
        "outDir": "./dist/esm",
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src/**/*"
    ]
}
